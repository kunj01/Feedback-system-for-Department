# Production Environment Configuration
# Training & Placement Tracking System
# Last Updated: December 9, 2025

# APPLICATION
APP_NAME="Training & Placement System"
APP_ENV=production
APP_KEY=base64:CHANGE_THIS_IN_PRODUCTION
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DATABASE
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training_laravel
DB_USERNAME=production_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# SESSION & CACHE
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=tnp_cache

# QUEUE
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# BROADCAST (Optional - not currently used)
BROADCAST_CONNECTION=log

# MAIL CONFIGURATION
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# FILE STORAGE
FILESYSTEM_DISK=local
# For S3 cloud storage, uncomment and configure:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# SECURITY
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# VITE (for production build)
VITE_APP_NAME="${APP_NAME}"

# RATE LIMITING (optional but recommended)
# THROTTLE_LOGIN_MAX_ATTEMPTS=5
# THROTTLE_LOGIN_DECAY_MINUTES=1
# THROTTLE_API_MAX_ATTEMPTS=60
# THROTTLE_API_DECAY_MINUTES=1

# ERROR TRACKING (Sentry - optional)
# SENTRY_LARAVEL_DSN=your-sentry-dsn
# SENTRY_TRACES_SAMPLE_RATE=0.2

# BACKUP CONFIGURATION (if using spatie/laravel-backup)
# BACKUP_DISK=s3
# BACKUP_NOTIFICATION_EMAIL=admin@your-domain.com

# CUSTOM APPLICATION SETTINGS
MAX_UPLOAD_SIZE=20480
ALLOWED_FILE_TYPES=pdf,doc,docx,zip,jpg,png
PROJECT_ID_PREFIX=TP
MAX_PROJECT_GROUP_SIZE=4
