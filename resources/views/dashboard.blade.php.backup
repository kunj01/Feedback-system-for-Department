            <h3 class="text-sm font-medium text-blue-800">How to complete feedback:</h3>
            <div class="mt-2 text-sm text-blue-700">
                <ul class="list-disc list-inside space-y-1">
                    <li>Click on any subject card to view faculty members</li>
                    <li>Select a faculty member to open their feedback form</li>
                    <li>Complete and submit the feedback form</li>
                    <li>Once all faculty feedback for a subject is complete, the subject card will turn green</li>
                    <li>You must complete feedback for all assigned subjects</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@endsection
